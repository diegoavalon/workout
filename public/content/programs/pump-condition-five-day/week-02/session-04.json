    "child": {
      "content": "[{\"insert\":\"Bike\",\"attributes\":{\"bold\":true}},{\"insert\":\" or\"},{\"insert\":\" Row \",\"attributes\":{\"bold\":true}},{\"insert\":\"20mins @ Easy Pace\\nAt minutes 4, 8, 12, 16, and 20 get off the rower and complete the following:\\n10 \"},{\"insert\":\"controlled 90/90 Hip Rolls \",\"attributes\":{\"bold\":true}},{\"insert\":\"(5/side)\\n10 \"},{\"insert\":\"Alternating Squat with Reach\",\"attributes\":{\"bold\":true}},{\"insert\":\" (hold 2sec/side)\\n25' \"},{\"insert\":\"Duck Walk\",\"attributes\":{\"bold\":true}},{\"insert\":\"\\n\\n\"},{\"insert\":\"Bike\",\"attributes\":{\"bold\":true}},{\"insert\":\" or\"},{\"insert\":\" Row \",\"attributes\":{\"bold\":true}},{\"insert\":\"20mins @ Easy Pace\\nAt minutes 4, 8, 12, 16, and 20 get off the bike and complete the following:\\n8 \"},{\"insert\":\"Perfect Stretch Walk \",\"attributes\":{\"bold\":true}},{\"insert\":\"(4/side)\\n25' \"},{\"insert\":\"Ostrich Walk\",\"attributes\":{\"bold\":true}},{\"insert\":\"\\n\\n*Move continuously at a steady pace for 40 minutes. Never exceed a pace that allows you to hold a comfortable conversation. You should not be breathing so heavily that you can't speak in complete sentences.\\n\"}]"
    }
